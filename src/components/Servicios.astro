---
import { servicios, teDamos, herramientas } from '../data/contenido';

const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const grupos = [
  { nombre: 'Servicios', items: servicios.map((s) => ({ nombre: s.nombre, desc: s.detalle })) },
  { nombre: 'Lo que te damos', items: teDamos.map((t) => ({ nombre: t.nombre, desc: `${cap(t.nota)}.` })) },
  { nombre: 'Herramientas', items: herramientas.map((h) => ({ nombre: h.nombre, desc: `Para ${h.nota}.` })) },
];
---

<section class="servicios wrap" id="servicios" aria-labelledby="servicios-t" data-indice>
  <h2 id="servicios-t">Qué hacemos</h2>

  <div class="indice grid">
    {
      grupos.map((g, gi) => (
        <div class="grupo" style={`--col:${1 + gi * 3}`}>
          <h3>{g.nombre}</h3>
          <ul data-reveal>
            {g.items.map((it) => (
              <li>
                <button type="button" class="item" data-nombre={it.nombre} data-desc={it.desc}>
                  {it.nombre}
                </button>
                <span class="item__desc">{it.desc}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="panel">
      <div class="panel__texto" data-panel aria-hidden="true">
        <p class="panel__nombre" data-panel-nombre>{servicios[0].nombre}</p>
        <p data-panel-desc>{servicios[0].detalle}</p>
      </div>
      <p class="panel__cierre">
        ¿No sabés por cuál empezar? <a class="link" href="#contacto">Contanos tu espacio</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .servicios {
    padding-block: var(--section-gap);
  }

  h2 {
    font-size: var(--step-lead);
    font-family: var(--serif);
    line-height: 1.2;
  }

  .indice {
    margin-top: 96px;
    align-items: start;
  }

  .grupo {
    grid-column: var(--col) / span 3;
  }

  .grupo h3 {
    font-weight: 500;
    margin-bottom: 1.3em;
  }

  .grupo ul {
    display: grid;
  }

  .item {
    display: block;
    width: 100%;
    padding: 3px 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font: 400 var(--step-body) / 1.3 var(--sans);
    text-align: left;
    cursor: default;
    transition: color 180ms ease;
  }

  .item:hover,
  .item:focus-visible,
  .item.is-on {
    color: var(--ink);
  }

  /* Oculta a la vista en escritorio (el panel la muestra), pero la leen los lectores de pantalla. */
  .item__desc {
    position: absolute;
    width: 1px; /* taste-skill-ignore: patrón sr-only, no es una línea */
    height: 1px; /* taste-skill-ignore: patrón sr-only, no es una línea */
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .panel {
    grid-column: 10 / -1;
    display: grid;
    gap: 32px;
  }

  .panel__texto {
    min-height: 7.5em;
    transition: opacity 220ms ease;
  }

  .panel__texto.is-swapping {
    opacity: 0;
  }

  .panel__nombre {
    font-weight: 500;
    margin-bottom: 6px;
  }

  .panel__cierre {
    color: var(--ink-soft);
  }

  @media (max-width: 960px) {
    .indice {
      row-gap: 48px;
    }

    .grupo {
      grid-column: span 6;
    }

    .panel {
      display: none;
    }

    .item {
      color: var(--ink);
      font-weight: 500;
      padding-top: 14px;
      pointer-events: none;
    }

    .item__desc {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
      white-space: normal;
      display: block;
      max-width: 44ch;
      color: var(--ink-soft);
      line-height: 1.45;
    }
  }

  @media (max-width: 760px) {
    .indice {
      margin-top: 48px;
      row-gap: 40px;
    }

    .grupo {
      grid-column: 1 / -1;
    }

    .grupo h3 {
      margin-bottom: 0.4em;
    }
  }
</style>
