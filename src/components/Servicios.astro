---
import { servicios, teDamos, herramientas } from '../data/contenido';

// Un dibujo por servicio, en una grilla de 100 × 100.
const iconos: Record<string, string[]> = {
  'Diseño de interiores': [
    'M26 46 C26 30 38 26 50 26 C62 26 74 30 74 46',
    'M18 62 C18 48 26 46 32 46 L68 46 C76 46 82 50 82 62 L82 72 L18 72 Z',
    'M24 72 L22 84 M76 72 L78 84',
  ],
  'Diseño inmobiliario': [
    'M16 50 L50 20 L84 50',
    'M26 42 L26 82 L74 82 L74 42',
    'M44 82 L44 62 L56 62 L56 82',
  ],
  'Ambientación de eventos': [
    'M8 24 C30 46 70 46 92 24',
    'M22 32 L26 50 L34 37',
    'M45 40 L50 58 L56 40',
    'M67 37 L72 54 L79 32',
  ],
  'Diseño de vidrieras': [
    'M14 28 L86 28 L80 42 L20 42 Z',
    'M22 42 L22 84 L78 84 L78 42',
    'M34 66 L66 66 M50 66 L50 52',
  ],
  Renderizado: [
    'M50 16 L82 33 L82 67 L50 84 L18 67 L18 33 Z',
    'M18 33 L50 50 L82 33',
    'M50 50 L50 84',
  ],
  Asesoramiento: [
    'M16 30 C16 22 22 18 30 18 L72 18 C80 18 86 22 86 30 L86 56 C86 64 80 68 72 68 L46 68 L28 84 L32 68 C22 68 16 64 16 56 Z',
    'M32 36 L70 36 M32 50 L58 50',
  ],
};
---

<section class="servicios wrap" id="servicios" aria-labelledby="servicios-t" data-tema="marron">
  <div class="cabeza">
    <h2 id="servicios-t">Qué hacemos</h2>
    <p class="mano cabeza__nota">seis servicios, un mismo criterio</p>
  </div>

  <ul class="lista">
    {
      servicios.map((s, i) => (
        <li class="servicio" data-draw>
          <svg class="trazos servicio__icono" viewBox="0 0 100 100" aria-hidden="true">
            <g style="--w:4.5">
              {(iconos[s.nombre] ?? []).map((d, k) => (
                <path pathLength="1" style={`--d:${k + i * 0.5}`} d={d} />
              ))}
            </g>
          </svg>
          <div>
            <h3>{s.nombre}</h3>
            <p>{s.detalle}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="extras">
    {
      [
        { titulo: 'Lo que te damos', items: teDamos },
        { titulo: 'Con qué trabajamos', items: herramientas },
      ].map((g) => (
        <div class="extra">
          <h3>{g.titulo}</h3>
          <ul data-draw>
            {g.items.map((it, k) => (
              <li>
                <svg class="trazos check" viewBox="0 0 60 60" aria-hidden="true">
                  <path pathLength="1" style={`--d:${k}; --w:5`} d="M8 32 L22 46 L52 12" />
                </svg>
                <span>
                  <strong>{it.nombre}</strong> <span class="extra__nota">{it.nota}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="extra extra--cierre">
      <p class="mano">¿No sabés por cuál empezar?</p>
      <a class="btn" href="#contacto">Contanos tu espacio</a>
    </div>
  </div>
</section>

<style>
  .servicios {
    padding-block: var(--section-gap);
  }

  .cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 32px;
  }

  .cabeza__nota {
    color: var(--celeste);
    rotate: -3deg;
  }

  .lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) clamp(32px, 6vw, 96px);
    margin-top: clamp(56px, 7vw, 96px);
  }

  .servicio {
    display: grid;
    grid-template-columns: clamp(64px, 7vw, 96px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .servicio__icono {
    width: 100%;
    color: var(--arena);
    transition: rotate 400ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .servicio:hover .servicio__icono {
      rotate: -8deg;
    }
  }

  .servicio h3 {
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .servicio p {
    margin-top: 10px;
    max-width: 42ch;
    color: var(--sec-soft);
  }

  .extras {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 48px clamp(32px, 6vw, 96px);
    margin-top: clamp(80px, 10vw, 144px);
  }

  .extra h3 {
    margin-bottom: 16px;
  }

  .extra ul {
    display: grid;
    gap: 6px;
  }

  .extra li {
    display: grid;
    grid-template-columns: 28px minmax(0, 1fr);
    gap: 10px;
    align-items: start;
  }

  .check {
    width: 26px;
    margin-top: 2px;
    color: var(--celeste);
  }

  .extra__nota {
    color: var(--sec-soft);
  }

  .extra--cierre {
    display: grid;
    gap: 20px;
    align-content: start;
    justify-items: start;
  }

  .extra--cierre .mano {
    color: var(--celeste);
  }

  @media (max-width: 960px) {
    .lista {
      grid-template-columns: minmax(0, 1fr);
    }

    .extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .extra--cierre {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .extras {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
