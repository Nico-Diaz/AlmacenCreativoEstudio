---
import { PiListLight, PiXLight } from 'react-icons/pi';
import Logo from './Logo.astro';
import { nav } from '../data/contenido';
---

<div class="barra wrap" data-tema="papel" data-barra>
  <a class="marca" href="#inicio" aria-label="Almacen Creativo, volver al inicio">
    <Logo class="marca__logo" />
    <span class="marca__nombre">Almacen Creativo</span>
  </a>
  <nav aria-label="Principal" class="barra__nav">
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="btn barra__accion" href="#contacto">Escribinos</a>
  <details class="menu">
    <summary>
      <span class="sr-only">Menú</span>
      <PiListLight className="menu__icono menu__icono--abrir" aria-hidden="true" />
      <PiXLight className="menu__icono menu__icono--cerrar" aria-hidden="true" />
    </summary>
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="#contacto">Contacto</a></li>
    </ul>
  </details>
</div>

<style>
  /* Barra fija que toma el color del capítulo que tiene debajo (lo cambia motion.ts). */
  .barra {
    position: sticky;
    top: 0;
    z-index: 30;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    height: var(--bar-h);
    transition:
      background-color 300ms ease,
      color 300ms ease;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    white-space: nowrap;
  }

  .marca :global(.marca__logo) {
    width: 44px;
    height: 44px;
    color: var(--sec-trazo);
    transition:
      transform 500ms var(--ease-out),
      color 300ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .marca:hover :global(.marca__logo) {
      transform: rotate(-12deg) scale(1.06);
    }
  }

  .marca__nombre {
    font-weight: 800;
    font-size: var(--step-lead);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .barra__nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
  }

  .barra__nav a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 600;
    font-size: var(--step-small);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: transparent;
    transition: text-decoration-color 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .barra__nav a:hover {
      text-decoration-color: currentColor;
    }
  }

  .barra__accion {
    justify-self: end;
    min-height: 44px;
    padding-inline: 22px;
    font-size: var(--step-small);
    transition:
      transform 160ms var(--ease-out),
      color 260ms ease,
      background-color 300ms ease;
  }

  .menu {
    display: none;
    position: relative;
    justify-self: end;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    display: grid;
    place-items: center;
    transition: transform 160ms var(--ease-out);
  }

  .menu summary:active {
    transform: scale(0.94);
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  /* Las líneas se vuelven una X al abrir: los dos íconos se cruzan con giro y opacidad. */
  .menu :global(.menu__icono) {
    grid-area: 1 / 1;
    width: 30px;
    height: 30px;
    transition:
      opacity 180ms ease,
      transform 260ms var(--ease-out);
  }

  .menu :global(.menu__icono--cerrar) {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .menu[open] :global(.menu__icono--abrir) {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .menu[open] :global(.menu__icono--cerrar) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu :global(.menu__icono) {
      transition: opacity 120ms ease;
      transform: none !important;
    }
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    min-width: 230px;
    padding: 12px 0;
    border-radius: 20px;
    background: var(--btn-bg);
    color: var(--btn-ink);
    transform-origin: top right;
  }

  .menu[open] ul {
    animation: menu-in 220ms var(--ease-out);
  }

  .menu a {
    display: block;
    padding: 12px 22px;
    font-weight: 700;
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }

  @media (max-width: 960px) {
    .barra {
      grid-template-columns: 1fr auto;
    }

    .barra__nav,
    .barra__accion {
      display: none;
    }

    .menu {
      display: block;
    }
  }

  @media (max-width: 380px) {
    .marca__nombre {
      font-size: 1.125rem;
    }
  }
</style>
