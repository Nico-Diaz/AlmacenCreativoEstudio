---
import { PiListLight, PiXLight } from 'react-icons/pi';
import { nav } from '../data/contenido';
---

<div class="barra wrap">
  <a class="marca" href="#inicio">Almacen Creativo</a>
  <nav aria-label="Principal" class="barra__nav">
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
  <a class="btn barra__accion" href="#contacto">Escribinos</a>
  <details class="menu">
    <summary>
      <span class="sr-only">Menú</span>
      <PiListLight className="menu__icono menu__icono--abrir" aria-hidden="true" />
      <PiXLight className="menu__icono menu__icono--cerrar" aria-hidden="true" />
    </summary>
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      <li><a href="#contacto">Contacto</a></li>
    </ul>
  </details>
</div>

<style>
  .barra {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    min-height: 88px;
  }

  .marca {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--step-lead);
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .barra__nav ul {
    display: flex;
    gap: clamp(16px, 2vw, 32px);
  }

  .barra__nav a {
    display: inline-block;
    padding-block: 10px;
    font-size: var(--step-small);
    text-decoration-line: underline;
    text-decoration-color: transparent;
    transition: text-decoration-color 180ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .barra__nav a:hover {
      text-decoration-color: currentColor;
    }
  }

  .barra__accion {
    justify-self: end;
    min-height: 44px;
    padding-inline: 20px;
    font-size: var(--step-small);
  }

  .menu {
    display: none;
    position: relative;
    justify-self: end;
  }

  .menu summary {
    list-style: none;
    cursor: pointer;
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    display: grid;
    place-items: center;
    transition: transform 160ms var(--ease-out);
  }

  .menu summary:active {
    transform: scale(0.94);
  }

  /* Las líneas se vuelven una X al abrir: los dos íconos se cruzan con giro y opacidad. */
  .menu :global(.menu__icono) {
    grid-area: 1 / 1;
    width: 28px;
    height: 28px;
    transition:
      opacity 180ms ease,
      transform 260ms var(--ease-out);
  }

  .menu :global(.menu__icono--cerrar) {
    opacity: 0;
    transform: rotate(-45deg) scale(0.8);
  }

  .menu[open] :global(.menu__icono--abrir) {
    opacity: 0;
    transform: rotate(45deg) scale(0.8);
  }

  .menu[open] :global(.menu__icono--cerrar) {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu :global(.menu__icono) {
      transition: opacity 120ms ease;
      transform: none !important;
    }
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu ul {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    min-width: 220px;
    padding: 12px 0;
    background: var(--ink);
    color: var(--paper);
    transform-origin: top right;
  }

  .menu[open] ul {
    animation: menu-in 200ms var(--ease-out);
  }

  .menu a {
    display: block;
    padding: 12px 20px;
    text-decoration: none;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  @media (max-width: 960px) {
    .barra {
      grid-template-columns: 1fr auto;
    }

    .barra__nav,
    .barra__accion {
      display: none;
    }

    .menu {
      display: block;
    }
  }
</style>
