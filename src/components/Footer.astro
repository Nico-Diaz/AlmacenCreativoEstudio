---
import Logo from './Logo.astro';
import { contacto, nav, creditos } from '../data/contenido';
---

<footer class="pie wrap" data-tema="bordo">
  <div class="pie__arriba">
    <Logo class="pie__logo" titulo="Almacen Creativo" />
    <ul class="pie__links">
      {nav.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
    </ul>
    <ul class="pie__contacto">
      <li><a class="link" href={`mailto:${contacto.email}`}>{contacto.email}</a></li>
      {
        contacto.telefonos.map((t) => (
          <li>
            <a class="link" href={`tel:${t.replace(/[^+\d]/g, '')}`}>{t}</a>
          </li>
        ))
      }
      {
        contacto.redes.map((r) => (
          <li>
            <a class="link" href={r.url} target="_blank" rel="noopener noreferrer">
              {r.nombre}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mano pie__firma">hecho a mano en Mendoza</p>
  </div>

  <p class="pie__marca" aria-hidden="true">Almacen Creativo</p>

  <p class="pie__legal">
    Mendoza, {new Date().getFullYear()}. Imágenes de archivo:{' '}
    {
      creditos.map((c, i) => (
        <>
          <a class="link" href={c.url} target="_blank" rel="noopener noreferrer">
            {c.titulo}
          </a>{' '}
          ({c.autor}, {c.licencia}){i < creditos.length - 1 ? '; ' : '.'}
        </>
      ))
    }
  </p>
</footer>

<style>
  .pie {
    overflow: hidden;
    padding-top: clamp(56px, 7vw, 96px);
    padding-bottom: 32px;
  }

  .pie__arriba {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 32px clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .pie :global(.pie__logo) {
    width: clamp(96px, 11vw, 160px);
    color: var(--arena);
    transition: rotate 600ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .pie :global(.pie__logo:hover) {
      rotate: -14deg;
    }
  }

  .pie__links,
  .pie__contacto {
    display: grid;
    gap: 6px;
    align-content: start;
    font-weight: 600;
  }

  .pie__contacto {
    text-align: right;
  }

  .pie a {
    display: inline-block;
    padding-block: 3px;
  }

  .pie__firma {
    grid-column: 2 / -1;
    color: var(--celeste);
    rotate: -2deg;
  }

  .pie__marca {
    margin-top: clamp(48px, 7vw, 112px);
    font-weight: 900;
    font-size: 12.6vw;
    line-height: 0.82;
    letter-spacing: -0.065em;
    white-space: nowrap;
    margin-left: -0.04em;
  }

  .pie__legal {
    margin-top: 32px;
    max-width: 72ch;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--sec-soft);
  }

  .pie__legal a {
    padding-block: 0;
  }

  @media (max-width: 760px) {
    .pie__arriba {
      grid-template-columns: minmax(0, 1fr);
    }

    .pie__contacto {
      text-align: left;
    }

    .pie__firma {
      grid-column: 1;
    }

    .pie__marca {
      font-size: 15vw;
      white-space: normal;
      line-height: 0.88;
    }
  }
</style>
