---
import { contacto } from '../data/contenido';

const [usuario, dominio] = contacto.email.split('@');
---

<footer class="pie wrap">
  <div class="arriba grid">
    <p class="marca">Almacen Creativo</p>
    <p class="nota">Interiores, propiedades, vidrieras y eventos, a partir de lo que ya tenés.</p>
    <p class="nota">{contacto.ciudad}<br />{contacto.horario}</p>
    <a class="link volver" href="#inicio">Volver arriba</a>
  </div>

  <a class="mail" href={`mailto:${contacto.email}`}>
    <span>{usuario}</span><span>@{dominio}</span>
  </a>

  <div class="meta">
    <ul>
      {
        contacto.redes.map((r) => (
          <li>
            <a class="link" href={r.url} target="_blank" rel="noopener noreferrer">
              {r.nombre}
            </a>
          </li>
        ))
      }
      {
        contacto.telefonos.map((t) => (
          <li>
            <a class="link" href={`tel:${t.replace(/[^+\d]/g, '')}`}>{t}</a>
          </li>
        ))
      }
    </ul>
    <p>Algunas fotos son temporales de Unsplash, a reemplazar por las del estudio.</p>
    <p>Mendoza, {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  .pie {
    display: grid;
    grid-template-rows: auto 1fr auto auto;
    min-height: 90svh;
    padding-top: 40px;
    padding-bottom: 28px;
    background: var(--ink-deep);
    color: var(--ground);
  }

  .arriba {
    font-size: var(--step-small);
    row-gap: 16px;
  }

  .marca {
    grid-column: 1 / span 3;
    font-size: var(--step-body);
    font-weight: 600;
  }

  .nota {
    grid-column: span 3;
  }

  .volver {
    grid-column: 12;
    justify-self: end;
    white-space: nowrap;
  }

  .mail {
    grid-row: 3;
    display: block;
    margin-bottom: 40px;
    font-size: clamp(2.5rem, 0.5rem + 6.9vw, 9rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-decoration: none;
    transition: color 240ms ease;
  }

  .mail span {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .mail:hover {
      color: var(--paper);
    }
  }

  .meta {
    grid-row: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 12px 24px;
    font-size: var(--step-small);
  }

  .meta ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .meta p:last-child {
    text-align: right;
  }

  @media (max-width: 760px) {
    .arriba {
      grid-template-columns: 1fr;
    }

    .marca,
    .nota,
    .volver {
      grid-column: 1;
      justify-self: start;
    }

    .mail {
      font-size: 7.4vw;
    }

    .meta {
      grid-template-columns: 1fr;
    }

    .meta p:last-child {
      text-align: left;
    }
  }
</style>
