---
import { Image } from 'astro:assets';
import cordillera from '../assets/archivo/cordillera.jpg';
import { contacto, nav, creditos } from '../data/contenido';
---

<footer class="pie">
  <div class="pie__foto">
    <Image
      src={cordillera}
      alt="Cordillera de los Andes nevada en Mendoza, con una ruta que cruza el valle"
      widths={[900, 1600, 2400]}
      sizes="100vw"
      loading="lazy"
    />
  </div>

  <div class="pie__arriba wrap">
    <ul class="pie__links">
      {nav.map((l) => <li><a class="link" href={l.href}>{l.label}</a></li>)}
    </ul>
    <ul class="pie__contacto">
      <li><a class="link" href={`mailto:${contacto.email}`}>{contacto.email}</a></li>
      {
        contacto.telefonos.map((t) => (
          <li>
            <a class="link" href={`tel:${t.replace(/[^+\d]/g, '')}`}>{t}</a>
          </li>
        ))
      }
      {
        contacto.redes.map((r) => (
          <li>
            <a class="link" href={r.url} target="_blank" rel="noopener noreferrer">
              {r.nombre}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="pie__abajo wrap">
    <p class="pie__marca">Almacen Creativo</p>
    <p class="pie__legal">
      Mendoza, {new Date().getFullYear()}. Imágenes de archivo:{' '}
      {
        creditos.map((c, i) => (
          <>
            <a class="link" href={c.url} target="_blank" rel="noopener noreferrer">
              {c.titulo}
            </a>{' '}
            ({c.autor}, {c.licencia}){i < creditos.length - 1 ? '; ' : '.'}
          </>
        ))
      }
    </p>
  </div>
</footer>

<style>
  .pie {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    color: var(--paper);
    background: #2f3a44;
    isolation: isolate;
  }

  .pie__foto {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .pie__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    filter: brightness(0.62);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pie__foto :global(img) {
      animation: deriva 40s var(--ease-soft) infinite alternate;
    }
  }

  @keyframes deriva {
    from {
      transform: scale(1.04) translateX(0);
    }
    to {
      transform: scale(1.1) translateX(-1.5%);
    }
  }

  .pie__arriba {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    padding-top: 32px;
  }

  .pie__links,
  .pie__contacto {
    display: grid;
    gap: 6px;
    align-content: start;
  }

  .pie__contacto {
    text-align: right;
  }

  .pie a {
    display: inline-block;
    padding-block: 3px;
  }

  .pie__abajo {
    grid-row: 3;
    padding-bottom: 32px;
  }

  .pie__marca {
    font-family: var(--serif);
    font-weight: 100;
    font-size: 10.2vw;
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
    margin-left: -0.04em;
  }

  .pie__legal {
    margin-top: 24px;
    max-width: 72ch;
    font-size: var(--step-small);
    line-height: 1.5;
  }

  .pie__legal a {
    padding-block: 0;
  }

  @media (max-width: 760px) {
    .pie {
      min-height: 88svh;
    }

    .pie__arriba {
      flex-direction: column;
      gap: 24px;
    }

    .pie__contacto {
      text-align: left;
    }

    .pie__marca {
      font-size: 13vw;
      white-space: normal;
      line-height: 0.95;
    }
  }
</style>
