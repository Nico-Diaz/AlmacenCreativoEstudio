---
import { preguntas } from '../data/contenido';
---

<section class="faq wrap" id="preguntas" aria-labelledby="preguntas-t" data-tema="papel">
  <div class="cabeza">
    <h2 id="preguntas-t">Preguntas frecuentes</h2>
    <p class="mano cabeza__nota">lo que más nos preguntan</p>
  </div>
  <div class="filas" data-reveal>
    {
      preguntas.map((p) => (
        <details class="fila">
          <summary>
            <h3>{p.q}</h3>
            <svg class="trazos signo" viewBox="0 0 40 40" aria-hidden="true">
              <path style="--w:4" d="M20 6 C21 16 19 26 20 34" class="signo__v" />
              <path style="--w:4" d="M6 20 C16 19 26 21 34 20" />
            </svg>
          </summary>
          <p class="respuesta">{p.a}</p>
        </details>
      ))
    }
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-gap);
  }

  .cabeza {
    display: grid;
    gap: 8px;
  }

  .cabeza__nota {
    color: var(--rojo);
    rotate: -2deg;
    transform-origin: left;
  }

  .filas {
    display: grid;
    gap: 10px;
    margin-top: clamp(48px, 6vw, 80px);
    margin-left: auto;
    width: min(100%, 860px);
  }

  .fila {
    border-radius: 22px;
    padding: 10px 24px;
    background: var(--arena);
    transition: background-color 260ms ease;
  }

  .fila[open] {
    background: var(--celeste);
    padding-bottom: 26px;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 56px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-size: var(--step-lead);
    font-weight: 700;
  }

  /* Signo más dibujado: el trazo vertical se va al abrir y queda un menos. */
  .signo {
    flex: none;
    width: 30px;
    color: var(--bordo);
    transition: rotate 400ms var(--ease-out);
  }

  .signo__v {
    transition: opacity 200ms ease;
  }

  .fila[open] .signo {
    rotate: 180deg;
  }

  .fila[open] .signo__v {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .signo {
      rotate: 90deg;
    }

    .fila[open] summary:hover .signo {
      rotate: 180deg;
    }
  }

  .respuesta {
    margin-top: 8px;
    max-width: 56ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fila[open] .respuesta {
      animation: respuesta-in 360ms var(--ease-out);
    }
  }

  @keyframes respuesta-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 760px) {
    .fila {
      padding-inline: 18px;
    }
  }
</style>
