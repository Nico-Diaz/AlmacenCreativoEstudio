---
import { preguntas } from '../data/contenido';
---

<section class="faq wrap" id="preguntas" aria-labelledby="preguntas-t" data-tema="palido">
  <h2 id="preguntas-t">Preguntas frecuentes</h2>
  <div class="lista grid">
    <div class="filas" data-reveal>
      {
        preguntas.map((p) => (
          <details class="fila">
            <summary>
              <h3>{p.q}</h3>
              <span class="chevron" aria-hidden="true" />
            </summary>
            <p class="respuesta">{p.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-gap);
  }

  h2 {
    font-size: clamp(2.75rem, 1rem + 4.6vw, 5.5rem);
  }

  .lista {
    margin-top: 80px;
  }

  .filas {
    grid-column: 5 / -1;
    display: grid;
    gap: 12px;
  }

  .fila {
    margin-inline: -24px;
    padding: 12px 24px;
    transition: background-color 240ms ease;
  }

  .fila[open] {
    background: var(--paper);
    padding-bottom: 28px;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 48px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary h3 {
    font-size: var(--step-lead);
    font-weight: 400;
    line-height: 1.25;
  }

  .chevron {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    transition: transform 260ms var(--ease-out);
  }

  .chevron::before,
  .chevron::after {
    content: '';
    position: absolute;
    top: 7px;
    width: 10px;
    height: 2px;
    background: currentColor;
  }

  .chevron::before {
    left: 0;
    transform: rotate(45deg);
  }

  .chevron::after {
    right: 0;
    transform: rotate(-45deg);
  }

  .fila[open] .chevron {
    transform: rotate(180deg);
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover .chevron {
      transform: translateY(2px);
    }

    .fila[open] summary:hover .chevron {
      transform: rotate(180deg) translateY(2px);
    }
  }

  .respuesta {
    margin-top: 12px;
    max-width: 48ch;
  }

  @media (prefers-reduced-motion: no-preference) {
    .fila[open] .respuesta {
      animation: respuesta-in 360ms var(--ease-out);
    }
  }

  @keyframes respuesta-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @media (max-width: 760px) {
    h2 {
      font-size: var(--step-head);
    }

    .lista {
      margin-top: 40px;
    }

    .filas {
      grid-column: 1 / -1;
      gap: 4px;
    }

    .fila {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }

    summary h3 {
      font-size: var(--step-lead);
    }
  }
</style>
