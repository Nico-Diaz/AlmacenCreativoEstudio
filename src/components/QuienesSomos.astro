---
import Logo from './Logo.astro';
import { datos } from '../data/contenido';
---

<section class="nosotras wrap" id="nosotras" aria-labelledby="nosotras-t" data-tema="papel">
  <div class="nosotras__grid">
    <div class="texto">
      <h2 id="nosotras-t">Quiénes somos</h2>
      <p class="bajada" data-fill>
        Trabajamos como un almacén de barrio: guardamos, ordenamos y volvemos a poner en uso lo que ya tenés.
      </p>
      <p class="cuerpo">
        Somos tres diseñadoras con base en Mendoza. Antes de comprar nada miramos lo que hay, escuchamos cómo se usa
        cada espacio y recién después dibujamos: primero a mano, encima de lo que existe, y después en planos y renders.
      </p>
    </div>

    <!-- El sello: el monograma sobre el celeste del logo, con tres verbos escritos alrededor. -->
    <div class="sello" data-draw>
      <div class="sello__disco">
        <Logo class="sello__logo" titulo="Logo de Almacen Creativo" />
      </div>
      <svg class="trazos sello__notas" viewBox="0 0 600 600" aria-hidden="true">
        <g class="t-bordo" style="--w:5">
          <text x="16" y="70" font-size="54" style="--d:1">guardamos</text>
          <path pathLength="1" style="--d:1" d="M150 92 C170 130 196 150 232 160 M232 160 L200 164 M232 160 L214 136"></path>
          <text x="372" y="70" font-size="54" style="--d:2">ordenamos</text>
          <path pathLength="1" style="--d:2" d="M480 92 C478 124 466 150 440 166 M440 166 L452 140 M440 166 L470 160"></path>
          <text x="30" y="590" font-size="54" style="--d:3">volvemos a usar</text>
          <path pathLength="1" style="--d:3" d="M120 540 C140 500 170 480 206 474 M206 474 L180 494 M206 474 L196 502"></path>
        </g>
      </svg>
    </div>
  </div>

  <dl class="datos" data-reveal>
    {
      datos.map((d) => (
        <div>
          <dt class="mano">{d.label}</dt>
          <dd>{d.valor}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .nosotras {
    padding-block: var(--section-gap);
  }

  .nosotras__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px clamp(32px, 6vw, 96px);
    align-items: center;
  }

  .texto {
    display: grid;
    gap: 28px;
  }

  .bajada {
    max-width: 38ch;
    font-size: clamp(1.5rem, 1rem + 1.2vw, 2.125rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .cuerpo {
    max-width: 48ch;
  }

  .sello {
    position: relative;
    width: min(100%, 460px);
    justify-self: center;
    aspect-ratio: 1;
  }

  .sello__disco {
    position: absolute;
    inset: 16%;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--celeste);
  }

  .sello :global(.sello__logo) {
    width: 74%;
    color: var(--rojo);
  }

  .sello__notas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* El sello gira apenas con el scroll, como si alguien lo apoyara sobre el papel. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sello__disco {
        animation: sello-gira linear both;
        animation-timeline: view();
        animation-range: cover 10% cover 70%;
      }
    }
  }

  @keyframes sello-gira {
    from {
      transform: rotate(-24deg) scale(0.9);
    }
    to {
      transform: rotate(6deg) scale(1);
    }
  }

  .datos {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px var(--col-gap);
    margin-top: clamp(56px, 7vw, 96px);
  }

  .datos dt {
    color: var(--rojo);
  }

  .datos dd {
    margin-top: 4px;
    font-size: var(--step-lead);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  @media (max-width: 960px) {
    .nosotras__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .datos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
