---
import { Image } from 'astro:assets';
import almacen from '../assets/archivo/almacen.jpg';
import { datos } from '../data/contenido';
---

<section class="nosotras wrap" id="nosotras" aria-labelledby="nosotras-t">
  <div class="apertura" data-reveal>
    <h2 id="nosotras-t">Quiénes somos</h2>
    <p class="bajada">
      Trabajamos como un almacén de barrio: guardamos, ordenamos y volvemos a poner en uso. Antes de comprar nada
      miramos lo que ya tenés, y diseñamos a partir de eso.
    </p>
  </div>

  <div class="mosaico grid">
    <figure class="foto">
      <div class="foto__marco" data-reveal-img>
        <Image
          src={almacen}
          alt="Almacén de ramos generales: estantes con radios, máquinas de escribir, relojes y cajas de sombreros sobre un mostrador vidriado"
          widths={[700, 1100, 1600]}
          sizes="(max-width: 760px) 100vw, 62vw"
          loading="lazy"
        />
      </div>
      <p class="papel">
        Somos tres diseñadoras con base en Mendoza. Escuchamos cómo se usa cada espacio y recién después dibujamos.
      </p>
      <figcaption class="nota">Un almacén de ramos generales, en el Museo Histórico de Casilda, Santa Fe.</figcaption>
    </figure>

    <div class="lado">
      <div class="plano" role="img" aria-label="Planta de una casa, con un punto en el ambiente donde empieza cada proyecto">
        <svg viewBox="0 0 120 150" aria-hidden="true">
          <path
            fill="var(--ground)"
            d="M10 10h100v44H62v44h48v42H10V98h24V54H10Z"
          ></path>
          <circle cx="34" cy="32" r="6" fill="var(--ink)"></circle>
        </svg>
      </div>
      <dl class="datos" data-reveal>
        {
          datos.map((d) => (
            <div>
              <dt class="nota">{d.label}</dt>
              <dd>{d.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .nosotras {
    padding-top: var(--section-gap);
  }

  .apertura {
    display: grid;
    gap: 24px;
  }

  .bajada {
    max-width: 46ch;
    font-size: var(--step-lead);
    line-height: 1.4;
  }

  .mosaico {
    margin-top: 72px;
    align-items: start;
  }

  .foto {
    position: relative;
    grid-column: 1 / span 8;
  }

  .foto__marco {
    overflow: hidden;
  }

  .foto :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .papel {
    position: absolute;
    top: 0;
    right: 0;
    width: min(320px, 46%);
    padding: 20px;
    background: var(--ground);
    line-height: 1.45;
  }

  .foto figcaption {
    margin-top: 12px;
  }

  .lado {
    grid-column: 9 / span 4;
    display: grid;
    gap: 32px;
  }

  .plano {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.6;
    background: var(--field);
    padding: 28px;
  }

  .plano svg {
    height: 100%;
    max-height: 220px;
    width: auto;
  }

  .datos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 16px;
  }

  .datos dd {
    margin-top: 2px;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .foto {
      grid-column: 1 / -1;
    }

    .lado {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      align-items: start;
      margin-top: 24px;
    }
  }

  @media (max-width: 760px) {
    .mosaico {
      margin-top: 40px;
    }

    .foto :global(img) {
      aspect-ratio: 4 / 3;
    }

    .papel {
      position: static;
      width: auto;
      padding: 16px 0 0;
    }

    .lado {
      grid-template-columns: 1fr;
    }

    .plano {
      aspect-ratio: 3 / 2;
    }
  }
</style>
