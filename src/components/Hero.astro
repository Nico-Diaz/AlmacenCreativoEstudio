---
import { Image } from 'astro:assets';
import Header from './Header.astro';
import stand from '../assets/fotos/trombetta-stand.jpg';
import pared from '../assets/fotos/altier-pared.jpg';
import sala from '../assets/fotos/pinotea-a.jpg';
---

<header class="hero" id="inicio">
  <Header />

  <div class="riel wrap grid">
    <figure class="copia copia--chica">
      <Image
        src={sala}
        alt="Sala con un sillón capitoné verde, una mesa de madera y tres láminas enmarcadas"
        widths={[300, 500]}
        sizes="(max-width: 960px) 34vw, 190px"
        loading="eager"
      />
    </figure>

    <div class="titular">
      <h1 class="lineas">
        <span class="linea"><span data-line style="--i:0">Interiores con</span></span>
        <span class="linea"><span data-line style="--i:1">lo que ya tenés</span></span>
      </h1>
      <div class="titular__copete" data-after-lines>
        <p>
          Somos un estudio de diseño de interiores en Mendoza. Casas, locales, vidrieras y eventos, a partir de lo que
          ya está.
        </p>
        <a class="btn" href="#contacto">Contanos tu espacio</a>
      </div>
    </div>

    <figure class="copia copia--alta">
      <div class="obturador" data-shutter>
        <Image
          src={pared}
          alt="Pared de exhibición de Altiér beauty con estantes de productos y podios espejados"
          widths={[500, 900, 1300]}
          sizes="(max-width: 960px) 75vw, 46vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption class="nota">Stand de Altiér beauty en feria</figcaption>
    </figure>

    <figure class="copia copia--ancha">
      <Image
        src={stand}
        alt="Stand rojo y blanco de Óptica Trombetta bajo una carpa negra en el torneo Máximo Navesi"
        widths={[600, 1000, 1600]}
        sizes="(max-width: 960px) 100vw, 30vw"
        loading="eager"
      />
      <figcaption class="nota">Stand Trombetta, torneo Máximo Navesi</figcaption>
    </figure>
  </div>
</header>

<style>
  .riel {
    padding-top: clamp(16px, 5vh, 56px);
    grid-template-rows: auto 1fr;
    align-items: start;
  }

  .copia :global(img) {
    width: 100%;
    object-fit: cover;
  }

  .copia figcaption {
    margin-top: 12px;
  }

  /* Las tres copias cuelgan de la misma línea superior, cada una de su tamaño. */
  .copia--chica {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .copia--chica :global(img) {
    aspect-ratio: 1;
    object-position: 30% 70%;
  }

  .titular {
    grid-column: 1 / span 3;
    grid-row: 2;
    padding-top: clamp(28px, 5vh, 56px);
    display: grid;
    gap: 28px;
  }

  h1 {
    font-size: clamp(2rem, 1rem + 2vw, 2.625rem);
    line-height: 1.04;
  }

  h1 span {
    white-space: nowrap;
  }

  .titular__copete {
    display: grid;
    gap: 28px;
    justify-items: start;
  }

  .titular__copete p {
    max-width: 30ch;
  }

  .copia--alta {
    grid-column: 4 / span 6;
    grid-row: 1 / span 2;
  }

  .obturador {
    overflow: hidden;
  }

  .copia--alta :global(img) {
    height: max(440px, calc(100svh - 190px));
    object-position: 50% 45%;
  }

  .copia--ancha {
    grid-column: 10 / -1;
    grid-row: 1 / span 2;
    margin-right: calc(-1 * var(--gutter));
  }

  .copia--ancha :global(img) {
    aspect-ratio: 4 / 3;
    object-position: 45% 60%;
  }

  .copia--ancha figcaption {
    padding-right: var(--gutter);
  }

  /* Tablet y celular: el riel se vuelve vertical y cambian los bordes izquierdos. */
  @media (max-width: 960px) {
    .riel {
      padding-top: 8px;
      grid-template-rows: none;
    }

    .copia--alta {
      grid-column: 1 / span 9;
      grid-row: 1;
    }

    .copia--alta :global(img) {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    .copia--alta figcaption {
      display: none;
    }

    .copia--chica {
      grid-column: 9 / -1;
      grid-row: 2;
      margin-top: -40px;
      position: relative;
    }

    .titular {
      display: contents;
    }

    h1 {
      grid-column: 1 / span 8;
      grid-row: 2;
      padding-top: 24px;
      font-size: clamp(1.75rem, 7.4vw, 3.25rem);
    }

    .titular__copete {
      grid-column: 1 / -1;
      grid-row: 3;
      margin-top: 20px;
      gap: 24px;
    }

    .copia--ancha {
      grid-column: 1 / -1;
      grid-row: 4;
      margin-top: 48px;
      margin-inline: calc(-1 * var(--gutter));
    }

    .copia--ancha :global(img) {
      aspect-ratio: 16 / 10;
    }

    .copia--ancha figcaption {
      padding-inline: var(--gutter);
    }
  }

  @media (min-width: 761px) and (max-width: 960px) {
    .copia--alta {
      grid-column: 1 / span 7;
    }

    .copia--chica {
      grid-column: 8 / span 3;
      grid-row: 1;
      margin-top: 0;
      align-self: end;
    }
  }

  @media (max-width: 760px) {
    .titular__copete .btn {
      width: 100%;
    }
  }
</style>
