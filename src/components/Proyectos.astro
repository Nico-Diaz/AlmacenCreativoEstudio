---
import { Image } from 'astro:assets';
import { proyectos } from '../data/contenido';

const cuadros = proyectos.flatMap((p, pi) => p.fotos.map((f) => ({ ...f, proyecto: pi })));
---

<section
  class="proyectos"
  id="proyectos"
  aria-labelledby="proyectos-t"
  data-obras
  style={`--n:${cuadros.length}`}
>
  <div class="escena">
    <div class="izq wrap">
      <h2 id="proyectos-t">Proyectos</h2>
      <p class="rescate" data-rescate aria-live="polite">{proyectos[0].resumen}</p>
      <ol class="indice">
        {
          proyectos.map((p, i) => (
            <li class:list={['fila', { 'is-on': i === 0 }]} data-fila={i} data-rescate-texto={p.resumen}>
              <span class="nombre">{p.titulo}</span>
              <span class="disc">{p.detalle}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="der">
      {
        cuadros.map((c, i) => (
          <Image
            class:list={['foto', { 'is-on': i === 0, 'foto--entera': c.contain }]}
            data-foto={i}
            data-proyecto={c.proyecto}
            src={c.src}
            alt={c.alt}
            widths={[600, 1000, 1600]}
            sizes="(max-width: 760px) 100vw, 62vw"
            loading="eager"
            decoding="async"
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .proyectos {
    height: calc(var(--n) * 45svh + 55svh);
  }

  .escena {
    position: sticky;
    top: 0;
    height: 100svh;
    display: grid;
    grid-template-columns: 38fr 62fr;
  }

  .izq {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding-top: 40px;
    padding-bottom: 32px;
    gap: 24px;
  }

  h2 {
    font-size: var(--step-display);
  }

  .rescate {
    align-self: center;
    max-width: 26ch;
    font-size: var(--step-lead);
    line-height: 1.3;
  }

  .fila {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding-block: 6px;
    color: var(--ink-soft);
    transition: color 240ms ease;
  }

  .fila.is-on {
    color: var(--ink);
  }

  .nombre {
    font-size: var(--step-lead);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .fila.is-on .nombre {
    font-weight: 600;
  }

  .disc {
    font-size: var(--step-small);
    text-align: right;
  }

  .der {
    position: relative;
    overflow: clip;
  }

  .foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foto--entera {
    object-fit: contain;
    background: #fff;
    padding: clamp(16px, 4vw, 64px);
  }

  :global(html:not(.js)) .foto:not(.is-on) {
    display: none;
  }

  :global(.js) .foto {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 900ms var(--ease-in-out);
  }

  :global(.js) .foto.is-on,
  :global(.js) .foto.is-past {
    clip-path: inset(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .foto {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .escena {
      grid-template-columns: 1fr;
      grid-template-rows: auto minmax(0, 1fr) auto;
    }

    .izq {
      display: contents;
    }

    h2 {
      font-size: 14vw;
      padding: 24px var(--gutter) 16px;
    }

    .der {
      grid-row: 2;
    }

    .rescate {
      grid-row: 3;
      padding: 16px var(--gutter) 0;
      font-size: var(--step-body);
      max-width: none;
    }

    .indice {
      grid-row: 4;
      padding: 8px var(--gutter) 20px;
    }

    .escena {
      grid-template-rows: auto minmax(0, 1fr) auto auto;
    }

    .fila {
      min-height: 40px;
    }

    .nombre {
      font-size: var(--step-body);
    }
  }
</style>
