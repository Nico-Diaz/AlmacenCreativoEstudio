---
import { Image } from 'astro:assets';
import { proyectos } from '../data/contenido';

const [altier, trombetta] = proyectos;
const [, ruleta, marca] = altier.fotos;
const [stand, croquis, config] = trombetta.fotos;

// Cada pieza cuelga a su tamaño (k = fracción del alto de la escena) y a su altura (pos).
type Pieza =
  | { tipo: 'texto'; titulo: string; detalle: string; resumen: string }
  | { tipo: 'foto'; foto: (typeof altier.fotos)[number]; titulo: string; dato: string; k: number; ratio: string; pos: string };

const piezas: Pieza[] = [
  { tipo: 'texto', titulo: altier.titulo, detalle: altier.detalle, resumen: altier.resumen },
  { tipo: 'foto', foto: marca, titulo: altier.titulo, dato: 'Cartel sobre cortinado', k: 1, ratio: '3 / 2', pos: 'start' },
  { tipo: 'foto', foto: ruleta, titulo: altier.titulo, dato: 'Ruleta de premios', k: 0.74, ratio: '4 / 5', pos: 'end' },
  { tipo: 'texto', titulo: trombetta.titulo, detalle: trombetta.detalle, resumen: trombetta.resumen },
  { tipo: 'foto', foto: stand, titulo: trombetta.titulo, dato: 'Render en el torneo', k: 0.88, ratio: '3 / 2', pos: 'center' },
  { tipo: 'foto', foto: croquis, titulo: trombetta.titulo, dato: 'Croquis y materiales', k: 0.7, ratio: '4 / 5', pos: 'start' },
  { tipo: 'foto', foto: config, titulo: trombetta.titulo, dato: 'Tres configuraciones', k: 0.66, ratio: '3 / 2', pos: 'end' },
];
---

<section class="proyectos" id="proyectos" aria-labelledby="proyectos-t" data-tema="arena" data-galeria>
  <div class="escena">
    <div class="cabeza wrap">
      <h2 id="proyectos-t">Proyectos recientes</h2>
      <p class="cabeza__ayuda mano">dos stands de marca, de la idea al armado</p>
    </div>
    <ul class="pista" tabindex="0" aria-label="Fotos de los proyectos">
      {
        piezas.map((p) =>
          p.tipo === 'texto' ? (
            <li class="obra obra--texto">
              <h3>{p.titulo}</h3>
              <p class="mano obra__detalle">{p.detalle}</p>
              <p class="obra__resumen">{p.resumen}</p>
            </li>
          ) : (
            <li
              class:list={['obra', { 'obra--lamina': p.foto.contain }]}
              style={`--k:${p.k};--ratio:${p.ratio};align-self:${p.pos}`}
            >
              <figure class="obra__fig" data-draw>
                <div class="obra__marco">
                  <Image
                    src={p.foto.src}
                    alt={p.foto.alt}
                    widths={[500, 900, 1400]}
                    sizes="(max-width: 900px) 80vw, 50vw"
                    loading="lazy"
                  />
                </div>
                <svg class="trazos obra__trazo" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <path pathLength="1" style="--w:0.9" d="M-2.5 1.5 C30 -1.2 70 1 102.5 -1.8 C101 35 103.4 70 101.8 102.6 C70 101 30 103.6 -1.6 101.8 C0.8 70 -1.8 35 -2.5 1.5" />
                </svg>
                <span class="obra__cinta" aria-hidden="true" />
                <figcaption>
                  <span class="obra__titulo">{p.titulo}</span>
                  <span class="mano obra__dato">{p.dato}</span>
                </figcaption>
              </figure>
            </li>
          ),
        )
      }
    </ul>
  </div>
</section>

<style>
  .proyectos {
    --alto: min(400px, 56svh);
    padding-block: var(--section-gap);
  }

  .cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
  }

  /* Base: fila nativa con swipe y snap (celular, ventanas angostas y movimiento reducido). */
  .pista {
    display: flex;
    align-items: flex-start;
    gap: clamp(20px, 3vw, 48px);
    margin-top: clamp(40px, 5vw, 64px);
    padding: 0 var(--gutter) 8px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .pista::-webkit-scrollbar {
    display: none;
  }

  .obra {
    flex: none;
    scroll-snap-align: start;
  }

  /* Cada foto lleva un marco dibujado que se pasa del borde, una cinta de papel y su nota. */
  .obra__fig {
    position: relative;
    width: max-content;
    padding: 14px 14px 0;
  }

  .obra__marco {
    overflow: hidden;
    border-radius: 6px;
  }

  .obra :global(img) {
    display: block;
    height: calc(var(--alto) * var(--k));
    width: auto;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .obra__trazo {
    position: absolute;
    top: 6px;
    left: 6px;
    width: calc(100% - 12px);
    height: calc(var(--alto) * var(--k) + 16px);
    color: var(--bordo);
  }

  .obra__cinta {
    position: absolute;
    top: 0;
    left: 24px;
    width: 84px;
    height: 26px;
    background: color-mix(in srgb, var(--celeste) 80%, transparent);
    rotate: -6deg;
    transition: rotate 400ms var(--ease-out);
  }

  .obra:nth-child(3n) .obra__cinta {
    left: auto;
    right: 20px;
    rotate: 7deg;
    background: color-mix(in srgb, var(--papel) 85%, transparent);
  }

  @media (hover: hover) and (pointer: fine) {
    .obra:hover :global(img) {
      transform: scale(1.05);
    }

    .obra:hover .obra__fig {
      rotate: -1deg;
    }

    .obra:hover .obra__cinta {
      rotate: -12deg;
    }
  }

  .obra__fig {
    transition: rotate 500ms var(--ease-out);
  }

  .obra--lamina .obra__marco {
    background: var(--papel);
  }

  .obra--lamina :global(img) {
    object-fit: contain;
    padding: 10%;
    mix-blend-mode: multiply;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 14px;
    font-size: var(--step-small);
  }

  .obra__titulo {
    font-weight: 700;
  }

  .obra__dato {
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
    color: var(--bordo);
  }

  .obra--texto {
    width: min(78vw, 32ch);
    align-self: end;
    display: grid;
    gap: 6px;
    padding-bottom: 40px;
  }

  .obra--texto h3 {
    font-size: var(--step-head);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
  }

  .obra__detalle {
    color: var(--rojo);
  }

  .obra__resumen {
    margin-top: 12px;
  }

  .cabeza__ayuda {
    color: var(--rojo);
    rotate: -2deg;
  }

  /* Escritorio con movimiento: la escena se fija y el scroll vertical corre la fila (lo mide motion.ts). */
  .proyectos.is-pinned {
    padding-block: 0;
  }

  .proyectos.is-pinned .escena {
    position: sticky;
    top: var(--bar-h);
    height: calc(100svh - var(--bar-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: clip;
  }

  .proyectos.is-pinned .pista {
    --alto: min(54svh, 580px);
    overflow: visible;
    scroll-snap-type: none;
    align-items: stretch;
    min-height: calc(var(--alto) + 48px);
    will-change: transform;
  }

  @media (max-width: 760px) {
    .obra--texto h3 {
      font-size: var(--step-lead);
    }
  }
</style>
