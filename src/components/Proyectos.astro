---
import { Image } from 'astro:assets';
import { proyectos } from '../data/contenido';

const [altier, trombetta] = proyectos;
const [, ruleta, marca] = altier.fotos;
const [stand, croquis, config] = trombetta.fotos;

const tiles = [
  { foto: marca, cls: 't-marca', titulo: altier.titulo, dato: altier.detalle, resumen: altier.resumen },
  { foto: ruleta, cls: 't-ruleta', titulo: altier.titulo, dato: 'Ruleta de premios' },
  { foto: croquis, cls: 't-croquis', titulo: trombetta.titulo, dato: 'Croquis y materiales', resumen: trombetta.resumen },
  { foto: stand, cls: 't-stand', titulo: trombetta.titulo, dato: trombetta.detalle },
  { foto: config, cls: 't-config', titulo: trombetta.titulo, dato: 'Tres configuraciones del stand' },
];
---

<section class="proyectos wrap" id="proyectos" aria-labelledby="proyectos-t">
  <div class="muro">
    <h2 id="proyectos-t" class="t-titulo">
      <span>Proyectos</span>
      <span>recientes</span>
    </h2>
    {
      tiles.map((t) => (
        <figure class:list={['tile', t.cls, { 'tile--lamina': t.foto.contain }]}>
          <div class="tile__marco" data-reveal-img>
            <Image
              src={t.foto.src}
              alt={t.foto.alt}
              widths={[500, 900, 1400]}
              sizes="(max-width: 760px) 90vw, 46vw"
              loading="lazy"
            />
          </div>
          <figcaption>
            <span class="tile__titulo">{t.titulo}</span>
            <span class="nota">{t.dato}</span>
          </figcaption>
          {t.resumen && <p class="tile__resumen">{t.resumen}</p>}
        </figure>
      ))
    }
  </div>
</section>

<style>
  .proyectos {
    padding-bottom: var(--section-gap);
  }

  .muro {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px) 16px;
    align-items: start;
  }

  .t-titulo {
    grid-column: 3;
    grid-row: 1;
    align-self: end;
    padding-bottom: 56px;
    font-size: clamp(2.25rem, 1rem + 3vw, 3.5rem);
  }

  .t-titulo span {
    display: block;
  }

  .t-marca {
    grid-column: 1 / span 2;
    grid-row: 1;
  }

  .t-ruleta {
    grid-column: 4;
    grid-row: 1;
  }

  .t-croquis {
    grid-column: 2;
    grid-row: 2;
  }

  .t-stand {
    grid-column: 3;
    grid-row: 2;
    margin-top: 96px;
  }

  .t-config {
    grid-column: 3 / span 2;
    grid-row: 3;
  }

  .tile__marco {
    overflow: hidden;
  }

  .tile :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .t-marca :global(img),
  .t-config :global(img) {
    aspect-ratio: 3 / 2;
  }

  .t-marca :global(img) {
    object-position: 50% 30%;
  }

  .t-stand :global(img) {
    object-position: 50% 60%;
  }

  .tile--lamina .tile__marco {
    background: var(--tone);
  }

  .tile--lamina :global(img) {
    object-fit: contain;
    padding: 12%;
    mix-blend-mode: multiply;
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin-top: 12px;
    font-size: var(--step-small);
  }

  .tile__titulo {
    font-weight: 500;
  }

  .tile__resumen {
    margin-top: 16px;
    max-width: 40ch;
  }

  @media (max-width: 960px) {
    .muro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 10px;
      row-gap: 40px;
    }

    .t-titulo {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-bottom: 0;
      font-size: var(--step-head);
    }

    .t-marca,
    .t-config {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .t-ruleta {
      grid-column: 2;
      grid-row: auto;
    }

    .t-croquis {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .t-croquis :global(img) {
      aspect-ratio: 3 / 2;
    }

    .t-stand {
      grid-column: 2;
      grid-row: auto;
      margin-top: 0;
    }

    .t-croquis,
    .t-stand {
      align-self: start;
    }

    .tile__resumen {
      grid-column: 1 / -1;
    }

    figcaption {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
