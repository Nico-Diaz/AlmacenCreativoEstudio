---
import { Image } from 'astro:assets';
import { pasos } from '../data/contenido';
import local from '../assets/fotos/esquina-a.jpg';
import sala from '../assets/archivo/sheraton-sala.jpg';
import layetier from '../assets/archivo/layetier.jpg';
import taller from '../assets/archivo/taller.jpg';

const fotos = [
  {
    src: local,
    alt: 'Café con una mesa larga de madera, dos tazas y una ventana a la calle',
    nota: 'El espacio como está.',
    pos: '50% 60%',
  },
  {
    src: sala,
    alt: 'Grabado de 1793 con la planta de una sala y sus cuatro paredes desplegadas alrededor',
    nota: 'Planta y alzados de una sala, Thomas Sheraton, 1793.',
    pos: '50% 45%',
  },
  {
    src: layetier,
    alt: 'Grabado de un taller de carpintería con bancos de trabajo y herramientas dibujados a escala',
    nota: 'Lámina de taller de la Encyclopédie.',
    pos: '50% 20%',
  },
  {
    src: taller,
    alt: 'Banco de carpintero con herramientas colgadas en la pared y tablas sobre la mesa',
    nota: 'Un taller de carpintería.',
    pos: '60% 50%',
  },
];
---

<section class="proceso wrap" id="proceso" aria-labelledby="proceso-t" data-tema="celeste" data-pasos>
  <h2 id="proceso-t">Cómo trabajamos</h2>

  <div class="sostenida">
    <div class="sostenida__media">
      <div class="sostenida__fotos">
        {
          fotos.map((f, i) => (
            <figure class:list={['foto', { 'is-on': i === 0 }]} data-foto-paso={i}>
              <Image
                src={f.src}
                alt={f.alt}
                widths={[600, 1000, 1400]}
                sizes="(max-width: 900px) 92vw, 54vw"
                loading="lazy"
                style={`object-position:${f.pos}`}
              />
              <figcaption class="nota">{f.nota}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="sostenida__cuenta" aria-hidden="true" data-cuenta>Paso 1 de {pasos.length}</p>
    </div>

    <ol class="sostenida__pasos">
      {
        pasos.map((p, i) => (
          <li class:list={['paso', { 'is-active': i === 0 }]} data-paso={i}>
            <figure class="paso__foto">
              <Image
                src={fotos[i].src}
                alt={fotos[i].alt}
                widths={[500, 900]}
                sizes="92vw"
                loading="lazy"
                style={`object-position:${fotos[i].pos}`}
              />
            </figure>
            <h3>{p.linea}</h3>
            <p>{p.detalle}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proceso {
    padding-block: var(--section-gap);
  }

  .sostenida {
    display: grid;
    grid-template-columns: 7fr 5fr;
    column-gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(40px, 5vw, 72px);
  }

  /* Sin JS: dos columnas planas, cada foto sobre su pie. */
  .sostenida__media {
    align-self: start;
  }

  .sostenida__fotos {
    display: grid;
    gap: 32px;
  }

  .foto :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .foto figcaption {
    margin-top: 10px;
  }

  .sostenida__cuenta {
    display: none;
  }

  .paso {
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .paso h3 {
    font-family: var(--serif);
    font-weight: 300;
    font-size: var(--step-head);
    line-height: 1.02;
    text-wrap: balance;
  }

  .paso p {
    max-width: 36ch;
  }

  /* Con JS: la foto queda sostenida y los pasos pasan; el del medio de la pantalla se enciende. */
  :global(.js) .sostenida__media {
    position: sticky;
    top: var(--bar-h);
    height: calc(100svh - var(--bar-h));
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }

  :global(.js) .sostenida__fotos {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    max-height: 68svh;
  }

  :global(.js) .foto {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 520ms ease;
  }

  :global(.js) .foto :global(img) {
    height: 100%;
    aspect-ratio: auto;
    transform: scale(1.06);
    transition: transform 1200ms var(--ease-out);
  }

  :global(.js) .foto figcaption {
    position: absolute;
    top: 100%;
  }

  :global(.js) .foto.is-on {
    opacity: 1;
  }

  :global(.js) .foto.is-on :global(img) {
    transform: none;
  }

  :global(.js) .sostenida__cuenta {
    display: block;
    margin-top: 28px;
    font-weight: 500;
  }

  :global(.js) .paso {
    opacity: 0.4;
    transition: opacity 400ms ease;
  }

  :global(.js) .paso.is-active {
    opacity: 1;
  }

  /* La copia de la foto dentro de cada paso solo se usa en pantallas chicas. */
  .paso__foto {
    display: none;
  }

  /* Tablet y celular: nada fijo; cada paso lleva su foto arriba, con alturas alternadas. */
  @media (max-width: 900px) {
    .sostenida {
      display: block;
    }

    .sostenida__media,
    :global(.js) .sostenida__media {
      display: none;
    }

    .paso__foto {
      display: block;
      margin-bottom: 12px;
    }

    .paso__foto :global(img) {
      width: 100%;
      aspect-ratio: 3 / 2;
      object-fit: cover;
    }

    .paso:nth-child(even) .paso__foto {
      width: 72%;
      margin-left: auto;
    }

    .paso,
    :global(.js) .paso {
      min-height: 0;
      opacity: 1;
      margin-bottom: 64px;
    }

    .paso:last-child {
      margin-bottom: 0;
    }

    .paso h3 {
      font-size: clamp(1.75rem, 7vw, 2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .foto,
    :global(.js) .foto :global(img),
    :global(.js) .paso {
      transition: none;
    }
  }
</style>
